<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".EditTimeTableActivity">

    <!-- Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbarRl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:src="@drawable/ic_back_black"
                app:tint="#222222" />

            <TextView
                android:id="@+id/dayTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Day"
                android:textColor="#111111"
                android:textSize="20sp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarRl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Edit Time Table"
                android:textColor="#111111"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/seg_ui_semibold"
                android:text="Update class schedule information"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <!-- Subject Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Subject Name"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/subjectEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_library_primary"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter subject name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Teacher Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Teacher Name"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/classTeacherNameEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_person_gray"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter teacher name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Start Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Start Time"
                android:textColor="#222222"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/startTimeTv"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_clock_black"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:gravity="center_vertical"
                android:hint="Pick start time"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- End Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="End Time"
                android:textColor="#222222"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/endTimeTv"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_clock_black"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:gravity="center_vertical"
                android:hint="Pick end time"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Ongoing Topic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Ongoing Topic"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/ongoingTopicEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_library_primary"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter ongoing topic"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Syllabus Completed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Syllabus Complete %"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/syllabusCompletedEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_person_gray"
                android:drawablePadding="14dp"
                android:drawableTint="#4A6CF7"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter syllabus completion percentage"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Update Button -->
            <Button
                android:id="@+id/updateTimeTableBtn"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#4A6CF7"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Update Time Table"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Progress -->
    <androidx.cardview.widget.CardView
        android:id="@+id/progressBar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>