<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".AddBooksActivity">

    <!-- Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbarRl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:src="@drawable/ic_back_black"
                app:tint="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Add Books To Library"
                android:textColor="#111111"
                android:textSize="20sp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbarRl"
        app:layout_constraintBottom_toTopOf="@id/btnRl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Upload New Book"
                android:textColor="#111111"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/seg_ui_semibold"
                android:text="Fill all book information carefully"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <!-- Subject -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Subject Name"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/subjectEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_library_primary"
                android:drawablePadding="16dp"
                android:drawableTint="@color/colorGray02"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter subject name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Book Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Book Name"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/bookNameEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_library_primary"
                android:drawablePadding="16dp"
                android:drawableTint="@color/colorGray02"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter book name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Author Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Author Name"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/authorNameEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_person_gray"
                android:drawablePadding="16dp"
                android:drawableTint="@color/colorGray02"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter author name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Book ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Book ID / Number"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/bookNoEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_lock_gray"
                android:drawablePadding="16dp"
                android:drawableTint="@color/colorGray02"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter book id or number"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

            <!-- Quantity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Books Quantity"
                android:textColor="#222222"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/booksQuantityEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#D6DCE5"
                android:drawableEnd="@drawable/ic_library_primary"
                android:drawablePadding="16dp"
                android:drawableTint="@color/colorGray02"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter books quantity"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Button -->
    <RelativeLayout
        android:id="@+id/btnRl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/uploadBookBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#4A6CF7"
            android:fontFamily="@font/segoe_ui_bold"
            android:text="Upload Book"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="visible" />

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:visibility="visible" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>