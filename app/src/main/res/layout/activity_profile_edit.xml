<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".ProfileEditActivity">

    <!-- Top Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbarRl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#4A6CF7"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:src="@drawable/ic_back_black"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/segoe_ui_bold"
                    android:text="@string/profile_edit_title"
                    android:textColor="@android:color/white"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/seg_ui_semibold"
                    android:text="Update your profile information"
                    android:textColor="#DCE4FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Main Scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarRl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <com.blogspot.atifsoftwares.circularimageview.CircularImageView
                        android:id="@+id/profileIv"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/ic_person_gray"
                        android:backgroundTint="#E9EEFF"
                        app:c_border="true"
                        app:c_border_color="#4A6CF7"
                        app:c_border_width="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/segoe_ui_bold"
                        android:text="Edit Profile"
                        android:textColor="#111111"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/seg_ui_semibold"
                        android:text="Manage your personal information"
                        android:textColor="#9A9A9A"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Name -->
                    <LinearLayout
                        android:id="@+id/nameRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_name"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/nameEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Enter name"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Verified Email -->
                    <LinearLayout
                        android:id="@+id/emailRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_email"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/emailEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:drawableEnd="@drawable/ic_verified_user"
                            android:focusable="false"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Enter email"
                            android:inputType="none"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp"
                            app:drawableTint="#00F459" />

                    </LinearLayout>

                    <!-- Not Verified Email -->
                    <LinearLayout
                        android:id="@+id/emailNotVerifiedRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv21"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_email"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/notVerifiedEmailTv"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:focusable="false"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Enter email"
                            android:inputType="none"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:id="@+id/phoneRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_phone"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/phoneTv"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:drawableEnd="@drawable/ic_verified_user"
                            android:focusable="false"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Enter phone"
                            android:inputType="none"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp"
                            app:drawableTint="#00F459" />

                    </LinearLayout>

                    <!-- Country / State / District -->
                    <LinearLayout
                        android:id="@+id/addressRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- Country -->
                        <LinearLayout
                            android:id="@+id/countryRl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv31"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="@string/label_country"
                                android:textColor="#111111"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/countryEt"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="8dp"
                                android:background="@android:drawable/edit_text"
                                android:backgroundTint="#DCE3EE"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:hint="N/A"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textColor="#111111"
                                android:textColorHint="#9A9A9A"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- State -->
                        <LinearLayout
                            android:id="@+id/stateRl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv13"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="@string/label_state"
                                android:textColor="#111111"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/stateEt"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="8dp"
                                android:background="@android:drawable/edit_text"
                                android:backgroundTint="#DCE3EE"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:hint="N/A"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textColor="#111111"
                                android:textColorHint="#9A9A9A"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- District -->
                        <LinearLayout
                            android:id="@+id/districtRl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv14"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="@string/label_district"
                                android:textColor="#111111"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/cityEt"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="8dp"
                                android:background="@android:drawable/edit_text"
                                android:backgroundTint="#DCE3EE"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:hint="N/A"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textColor="#111111"
                                android:textColorHint="#9A9A9A"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:id="@+id/cAddressRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_complete_address"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/addressEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Registration -->
                    <LinearLayout
                        android:id="@+id/regiNoRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_registration_no"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/regNoEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- DOB -->
                    <LinearLayout
                        android:id="@+id/dobRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_dob"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/dobEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="dd/mm/yyyy"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Father -->
                    <LinearLayout
                        android:id="@+id/fatherNameRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_father_name"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/fatherNameEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Mother -->
                    <LinearLayout
                        android:id="@+id/motherNameRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_mother_name"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/motherNameEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Branch -->
                    <LinearLayout
                        android:id="@+id/branchRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_branch"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/branchEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Semester -->
                    <LinearLayout
                        android:id="@+id/semRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_semester"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/semEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Session -->
                    <LinearLayout
                        android:id="@+id/sessionRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_session"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/sessionEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Seat -->
                    <LinearLayout
                        android:id="@+id/seatRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_ui_bold"
                            android:text="@string/label_seat_type"
                            android:textColor="#111111"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/seatTypeEt"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:backgroundTint="#DCE3EE"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:hint="Not provided"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:textColor="#111111"
                            android:textColorHint="#9A9A9A"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Update Button -->
                    <Button
                        android:id="@+id/updateBtn"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="34dp"
                        android:backgroundTint="#4A6CF7"
                        android:elevation="2dp"
                        android:fontFamily="@font/segoe_ui_bold"
                        android:text="@string/btn_update"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Progress -->
    <androidx.cardview.widget.CardView
        android:id="@+id/progressBar"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
