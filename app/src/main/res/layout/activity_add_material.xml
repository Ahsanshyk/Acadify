<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    tools:context=".AddMaterialActivity">

    <!-- Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back_black"
                app:tint="#222222"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Upload Material"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/segoe_ui_bold"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Study Material"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/segoe_ui_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Upload notes, assignments or PDFs for students."
                android:textColor="#7A7A7A"
                android:textSize="14sp"
                android:fontFamily="@font/seg_ui_semibold"/>

            <!-- PDF Upload Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/pickPdfBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_pdf_ttachment_white"
                        app:tint="#FF6B35"/>

                    <TextView
                        android:id="@+id/selectedFileNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/segoe_ui_bold"
                        android:text="Tap to select PDF file"
                        android:textColor="#111111"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/seg_ui_semibold"
                        android:text="Only PDF documents are supported"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Subject Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Subject Name"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/segoe_ui_bold"/>

            <EditText
                android:id="@+id/subNameEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter subject name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp"/>

            <!-- Topic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Chapter / Topic"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/segoe_ui_bold"/>

            <EditText
                android:id="@+id/subTopicEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:fontFamily="@font/seg_ui_semibold"
                android:hint="Enter topic name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111111"
                android:textColorHint="#9A9A9A"
                android:textSize="15sp"/>

            <!-- Semester + Branch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semester"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/segoe_ui_bold"/>

                    <AutoCompleteTextView
                        android:id="@+id/semTv"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edittext_bg"
                        android:fontFamily="@font/seg_ui_semibold"
                        android:hint="Select"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#111111"
                        android:textColorHint="#9A9A9A"
                        android:textSize="15sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Branch"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/segoe_ui_bold"/>

                    <AutoCompleteTextView
                        android:id="@+id/branchTv"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edittext_bg"
                        android:fontFamily="@font/seg_ui_semibold"
                        android:hint="Select"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#111111"
                        android:textColorHint="#9A9A9A"
                        android:textSize="15sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Upload Button -->
            <Button
                android:id="@+id/uploadMaterialBtn"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="34dp"
                android:backgroundTint="#4A6CF7"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Confirm and Upload"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>