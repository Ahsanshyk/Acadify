<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    Design System: Material Soft Card UI
    Background : #F5F7FA
    Primary Blue: #4A6CF7  |  Accent: #6D89FF
    Drawer      : White, 300dp, elevation 14dp
    Fonts       : Segoe UI Bold / SemiBold
    Margins     : 16dp outer system
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity"
    tools:openDrawer="start">

    <!-- ═══════════════════════════════════════════════
         MAIN CONTENT  (soft card shell)
    ════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            app:cardBackgroundColor="#F5F7FA"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <include
                layout="@layout/app_bar_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════
         NAVIGATION DRAWER
         Styled to match the soft-card design system:
         — White background
         — Blue primary tint on icons & active states
         — Segoe UI body text
         — Soft ripple & item shape matching 20dp radius
    ════════════════════════════════════════════════ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:elevation="14dp"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:headerLayout="@layout/header_layout"
        app:itemBackground="@color/white"
        app:itemHorizontalPadding="16dp"
        app:itemIconPadding="16dp"
        app:itemIconSize="22dp"
        app:itemIconTint="#4A6CF7"
        app:itemRippleColor="#DDE4FF"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
        app:itemTextAppearance="@style/TextAppearance.AppCompat.Body1"
        app:itemTextColor="#111111"
        app:menu="@menu/navigation_items" />

</androidx.drawerlayout.widget.DrawerLayout>