<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".ContentActivity">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">
            <!-- ══════════════════════════════════════
                 HEADER CARD  — original id: toolbarRl
            ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/toolbarRl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#4A6CF7"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/drawerBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:navigationIconTint="#FFFFFF" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_toEndOf="@id/drawerBtn"
                        android:layout_toStartOf="@id/profileIv"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/hello"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="Hello, "
                                android:textColor="#FFFFFF"
                                android:textSize="19sp" />
                            <TextView
                                android:id="@+id/nameTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="Anurag Kashyap"
                                android:textColor="#FFFFFF"
                                android:textSize="19sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/seg_ui_semibold"
                            android:text="Have a great day ✨"
                            android:textColor="#C8D4FF"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <com.blogspot.atifsoftwares.circularimageview.CircularImageView
                        android:id="@+id/profileIv"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_gray"
                        android:tint="@color/colorGray02"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="2dp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <!-- ══════════════════════════════════════
                 SCHEDULE SECTION HEADER
            ══════════════════════════════════════ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/scheduleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_ui_regular"
                        android:text="Your Schedule"
                        android:textColor="#9A9A9A"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/ongoingTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/segoe_ui_bold"
                        android:text="Today"
                        android:textColor="#111111"
                        android:textSize="22sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/seeAllTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/seg_ui_semibold"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="See All"
                    android:textColor="#4A6CF7"
                    android:textSize="12sp" />
            </RelativeLayout>
            <!-- ══════════════════════════════════════
                 TIMETABLE CARD  — original id: cardView
            ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:id="@+id/classRv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/timeTableRv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/row_timetable" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <!-- ══════════════════════════════════════
                 QUICK ACCESS  — original id: rl1
            ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/rl1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/IvLl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Notice -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/noticeRl"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E8EDF7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/noticeIv"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/shape_rect_05"
                                android:backgroundTint="#EEF2FF"
                                android:padding="14dp"
                                android:src="@drawable/ic_notice_primary"
                                app:tint="#4A6CF7" />

                            <TextView
                                android:id="@+id/noticeTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:text="Notice"
                                android:textColor="#111111"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Classroom -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/classroomRl"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E8EDF7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/classroomIv"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/shape_rect_05"
                                android:backgroundTint="#EEF2FF"
                                android:padding="14dp"
                                android:src="@drawable/ic_classroom_primary"
                                app:tint="#4A6CF7" />

                            <TextView
                                android:id="@+id/classroomTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:text="Classroom"
                                android:textColor="#111111"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Time Table -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/timeTableRl"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E8EDF7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/timeTableIv"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/shape_rect_05"
                                android:backgroundTint="#EEF2FF"
                                android:padding="14dp"
                                android:src="@drawable/ic_library_primary"
                                app:tint="#4A6CF7" />

                            <TextView
                                android:id="@+id/timeTableTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:text="Time Table"
                                android:textColor="#111111"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/IvLl2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Library -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/libraryRl"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E8EDF7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/libraryIv"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/shape_rect_05"
                                android:backgroundTint="#EEF2FF"
                                android:padding="14dp"
                                android:src="@drawable/ic_material_primary"
                                app:tint="#4A6CF7" />

                            <TextView
                                android:id="@+id/libraryTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:text="Library"
                                android:textColor="#111111"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Materials -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialRl"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E8EDF7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/materialIv"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/shape_rect_05"
                                android:backgroundTint="#EEF2FF"
                                android:padding="14dp"
                                android:src="@drawable/ic_material_primary"
                                app:tint="#4A6CF7" />

                            <TextView
                                android:id="@+id/materialTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/seg_ui_semibold"
                                android:text="Materials"
                                android:textColor="#111111"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1" />

                </LinearLayout>

            </LinearLayout>
            <!-- ══════════════════════════════════════
                 IMAGE SLIDER  — original id: slider
            ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">
                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/slider"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    app:iss_auto_cycle="true"
                    app:iss_corner_radius="22"
                    app:iss_delay="3000"
                    app:iss_period="4000" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>