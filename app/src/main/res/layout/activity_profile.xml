<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".ProfileActivity">

    <!-- Header Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBg"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#4A6CF7"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@drawable/ic_back_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/titleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="@string/profile_title"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/backBtn" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileIv"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginTop="10dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleTv"
                app:shapeAppearance="@style/styleRoundCornerImage"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Profile Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <!-- Name Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/segoe_ui_bold"
                    android:text="@string/sample_full_name"
                    android:textColor="#111111"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/adminVector"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified_user"
                    android:visibility="gone"
                    app:drawableTint="#00F459"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <TextView
                android:id="@+id/emailTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/seg_ui_semibold"
                android:text="@string/sample_email"
                android:textColor="#8A8A8A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/uniqueIdTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="#EEF2FF"
                android:fontFamily="@font/segoe_ui_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/sample_uid"
                android:textColor="#4A6CF7"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/phoneTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/seg_ui_semibold"
                android:text="@string/sample_phone"
                android:textColor="#8A8A8A"
                android:textSize="11sp" />

            <!-- Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/locationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/detailsLl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Country -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_country"
                                android:textColor="#9A9A9A"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:ignore="SmallSp" />

                            <TextView
                                android:id="@+id/countryTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/not_available"
                                android:textColor="#111111"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- State -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_state"
                                android:textColor="#9A9A9A"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/stateTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/not_available"
                                android:textColor="#111111"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- City -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_city"
                                android:textColor="#9A9A9A"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cityTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/not_available"
                                android:textColor="#111111"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/view1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#EEF2F7" />

                    <TextView
                        android:id="@+id/addressTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="2"
                        android:text="@string/label_address"
                        android:textColor="#111111"
                        android:textSize="11sp" />

                    <View
                        android:id="@+id/bottomBg"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/shape_rect04" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#EEF2F7" />

            <!-- Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:shrinkColumns="1"
                    android:stretchColumns="1">

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_registration_no"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/regNoTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_dob"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dobTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_dob"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_father_name"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/fatherNameTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_mother_name"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/motherNameTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_branch"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/branchTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_semester"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/semesterTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_session"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sessionTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow android:paddingBottom="5dp">

                        <TextView
                            android:text="@string/label_seat_type"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/seatTypeTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                    <TableRow>

                        <TextView
                            android:text="@string/label_hostler"
                            android:textColor="#8A8A8A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hostlerTv"
                            android:layout_marginStart="6dp"
                            android:text="@string/sample_data"
                            android:textColor="#111111"
                            android:textSize="10sp" />

                    </TableRow>

                </TableLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/profileEditBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit_white"
        app:backgroundTint="#4A6CF7"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@android:color/white"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>