<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".LoginActivity">

    <!-- Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbarCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:src="@drawable/ic_back_black"
                app:tint="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="Material Details"
                android:textColor="#111111"
                android:textSize="20sp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/materialOptionsLl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Material Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/materialRl"
                            android:layout_width="110dp"
                            android:layout_height="150dp"
                            app:cardBackgroundColor="#EEF2F7"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/pdfView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="20dp"
                                android:src="@drawable/ic_material_primary"
                                app:tint="#4A6CF7" />

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/subjectTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/segoe_ui_bold"
                                android:text="Title of Book"
                                android:textColor="#111111"
                                android:textSize="20sp" />

                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp">

                                <TableRow>

                                    <TextView
                                        android:id="@+id/categoryLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Topic"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/topicTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                                <TableRow android:layout_marginTop="8dp">

                                    <TextView
                                        android:id="@+id/dateLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Date"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/dateTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                                <TableRow android:layout_marginTop="8dp">

                                    <TextView
                                        android:id="@+id/sizeLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Size"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/sizeTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                                <TableRow android:layout_marginTop="8dp">

                                    <TextView
                                        android:id="@+id/viewsLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Views"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/viewsTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                                <TableRow android:layout_marginTop="8dp">

                                    <TextView
                                        android:id="@+id/downloadsLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Downloads"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/downloadsTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                                <TableRow android:layout_marginTop="8dp">

                                    <TextView
                                        android:id="@+id/pagesLabelTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/segoe_ui_bold"
                                        android:text="Pages"
                                        android:textColor="#222222"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/pagesTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:fontFamily="@font/seg_ui_semibold"
                                        android:text="N/A"
                                        android:textColor="#666666"
                                        android:textSize="13sp" />

                                </TableRow>

                            </TableLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Comments Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/commentsLabelTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_ui_bold"
                        android:text="Comments"
                        android:textColor="#111111"
                        android:textSize="18sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/commentsRv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/row_comment" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Options -->
    <LinearLayout
        android:id="@+id/materialOptionsLl"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@android:color/white"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/readMaterialBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#4A6CF7"
            android:drawableTop="@drawable/ic_library_primary"
            android:fontFamily="@font/segoe_ui_bold"
            android:text="Read"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:drawableTint="@android:color/white" />

        <Button
            android:id="@+id/downloadMaterialBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:backgroundTint="#4A6CF7"
            android:drawableTop="@drawable/ic_download_white"
            android:fontFamily="@font/segoe_ui_bold"
            android:text="Download"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:drawableTint="@android:color/white" />

        <Button
            android:id="@+id/favoriteBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#4A6CF7"
            android:drawableTop="@drawable/ic_favorite_border_white"
            android:fontFamily="@font/segoe_ui_bold"
            android:text="Favorite"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:drawableTint="@android:color/white" />

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addCommentBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="95dp"
        android:backgroundTint="#4A6CF7"
        android:elevation="6dp"
        android:src="@drawable/ic_comment_add_black"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>